{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(powershell -ExecutionPolicy Bypass -File ./validate-protocol.ps1)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$(git -C \"${CLAUDE_PROJECT_DIR:-.}\" rev-parse --show-toplevel 2>/dev/null)\" && [ -f \"$r/.claude/hooks/session-start.sh\" ] && bash \"$r/.claude/hooks/session-start.sh\" || true",
            "timeout": 30,
            "statusMessage": "Loading AI protocol state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$(git -C \"${CLAUDE_PROJECT_DIR:-.}\" rev-parse --show-toplevel 2>/dev/null)\" && [ -f \"$r/.claude/hooks/stop-worklog-check.sh\" ] && bash \"$r/.claude/hooks/stop-worklog-check.sh\" || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
