      "model": {
        "how": "flag",
        "listing": [
          "kilo",
          "models"
        ]
      },
      "effort": {
        "how": "flag",
        "values": [
          "high",
          "max",
          "minimal"
        ],
        "note": null
      },
      "env": {},
      "resume": {
        "command": [
          "kilo",
          "--session",
          "{sessionId}"
        ],
        "sessionId": "printed in launch output",
        "note": "supports --session <id>"
      },
      "usage": "kilo-json",
      "failureModes": []
    },
    "kimi": {
      "binary": "kimi",
      "present": true,
      "version": "2.1.1",
      "verifiedOn": "2026-09-26",
      "source": "kimi --version; kimi --help",
      "command": [
        "kimi",
        "-p",
        "{message}",
        {
          "if": "model",
          "args": [
            "-m",
            "{model}"
          ]
        },
        "--output-format",
        "stream-json"
